# Base URL of the Express + Socket.io backend
NEXT_PUBLIC_API_URL=http://localhost:5000

# "Continue with Google" button (Google Identity Services). Must be the same
# OAuth Client ID as backend/.env's GOOGLE_CLIENT_ID — see that file's comment
# for how to create one. Public value (not a secret), safe to expose to the browser.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

