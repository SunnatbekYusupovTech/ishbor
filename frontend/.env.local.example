# Base URL of the Express + Socket.io backend
NEXT_PUBLIC_API_URL=http://localhost:5000

# "Continue with Google" — only used to decide whether GoogleSignInButton
# renders at all; the button itself just links to the backend's own
# GET /auth/google (the actual OAuth redirect flow lives entirely server
# side). Must be the same value as backend/.env's GOOGLE_CLIENT_ID — see that
# file's comment for how to create one. Public value (not a secret).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

